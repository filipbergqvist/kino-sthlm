<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. Same reasoning as backup_rules.xml: the encrypted Trakt tokens cannot survive a
  move to another device, so they are excluded from both cloud backup and device transfer.
  Everything else (watchlist, settings, cached screenings) restores fine.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="trakt_tokens.xml" />
        <exclude domain="sharedpref" path="trakt_tokens_plain.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="trakt_tokens.xml" />
        <exclude domain="sharedpref" path="trakt_tokens_plain.xml" />
    </device-transfer>
</data-extraction-rules>
