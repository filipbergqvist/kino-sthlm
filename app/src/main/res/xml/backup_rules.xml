<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older. The Trakt tokens are encrypted with a key held in the device keystore,
  which is never backed up, so restoring them onto another device yields undecryptable garbage.
  Exclude them and let the user reconnect instead.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="trakt_tokens.xml" />
    <exclude domain="sharedpref" path="trakt_tokens_plain.xml" />
</full-backup-content>
